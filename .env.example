# Local development defaults. Copy to .env. Do not use these secrets in production.
# If a host port is already taken, change only the host side (POSTGRES_PORT, REDIS_PORT,
# MINIO_PORT, MINIO_CONSOLE_PORT, PORT) and keep DATABASE_URL and VITE_DEV_API_PROXY in sync.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
ENABLE_API_DOCS=true

POSTGRES_USER=scholarflow
POSTGRES_PASSWORD=scholarflow
POSTGRES_DB=scholarflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scholarflow:scholarflow@localhost:5432/scholarflow?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=scholarflow
MINIO_ROOT_PASSWORD=scholarflow-dev-secret
MINIO_PORT=9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=scholarflow
MINIO_USE_SSL=false

SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Leave empty in local development so the Vite dev server proxies /api.
VITE_API_URL=
VITE_DEV_API_PROXY=http://localhost:3000
